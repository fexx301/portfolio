# Copy to .env and fill in. Get a free key at https://web3forms.com
# (frontend-safe — it only routes form submissions to your inbox)
VITE_WEB3FORMS_ACCESS_KEY=your-access-key-here

# Server-only (no VITE_ prefix, so it never reaches the browser). Used by api/ask.js.
# Create a NEW key at https://openrouter.ai/settings/keys (set a credit limit on it),
# and add the same values in Vercel: Project > Settings > Environment Variables.
OPENROUTER_API_KEY=
# Optional. Defaults to anthropic/claude-haiku-5.5.
OPENROUTER_MODEL=
